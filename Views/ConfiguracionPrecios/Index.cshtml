@model IEnumerable<FactorFitGym.Web.Models.ConfiguracionPrecio>

@{
    ViewData["Title"] = "Gestión de Precios";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

@functions {
    public (string icon, string badgeClass, string bgIconColor, string textColor, string periodicity, string badgeText) GetCardMeta(string clave)
    {
        return clave switch
        {
            "PLAN_BASICO" => ("bi-trophy-fill", "bg-secondary bg-opacity-10 text-secondary border-secondary border-opacity-25", "rgba(100, 116, 139, 0.12)", "#475569", "por mes", "Plan Básico"),
            "PLAN_PREMIUM" => ("bi-star-fill", "bg-warning bg-opacity-15 text-dark border-warning border-opacity-50", "rgba(245, 158, 11, 0.15)", "#b45309", "por mes", "Destacado"),
            "PLAN_FULL" => ("bi-gem", "bg-primary bg-opacity-10 text-primary border-primary border-opacity-25", "rgba(10, 88, 202, 0.12)", "#0A58CA", "por mes", "Full Access"),
            "CANCHA_HORA" => ("bi-dribbble", "bg-success bg-opacity-10 text-success border-success border-opacity-25", "rgba(16, 185, 129, 0.15)", "#059669", "por hora", "Deporte"),
            _ => ("bi-tag-fill", "bg-info bg-opacity-10 text-info border-info border-opacity-25", "rgba(14, 165, 233, 0.12)", "#0284c7", "", "Tarifa")
        };
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-tags-fill text-brand me-2"></i>Gestión de Precios
        </h2>
        <p class="text-muted mb-0 small">Configura y actualiza las tarifas de membresías y servicios de Factor Gym.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-pill px-4 shadow-sm mb-4 border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row justify-content-center g-4">
    @foreach (var item in Model)
    {
        var meta = GetCardMeta(item.Clave);
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3 d-flex">
            <div class="card border-0 shadow-sm w-100 price-card d-flex flex-column justify-content-between text-center position-relative">
                
                <div class="p-4 p-md-4 d-flex flex-column align-items-center flex-grow-1">
                    <!-- Icono Centrado -->
                    <div class="rounded-4 d-inline-flex align-items-center justify-content-center mb-3 shadow-xs" 
                         style="width: 64px; height: 64px; background-color: @meta.bgIconColor; color: @meta.textColor;">
                        <i class="bi @meta.icon fs-2"></i>
                    </div>

                    <!-- Badge de categoría -->
                    <span class="badge rounded-pill border px-3 py-1 fw-bold small mb-2 @meta.badgeClass">
                        @meta.badgeText
                    </span>

                    <!-- Nombre del Plan / Servicio -->
                    <h5 class="fw-bold text-dark mb-2 text-center" style="font-size: 1.15rem; min-height: 2.5rem; display: flex; align-items: center; justify-content: center;">
                        @item.Nombre
                    </h5>

                    <!-- Pequeña Descripción -->
                    <p class="text-muted small text-center mb-4 px-1 flex-grow-1" style="line-height: 1.5; min-height: 48px;">
                        @(string.IsNullOrWhiteSpace(item.Descripcion) ? "Tarifa general configurada para el gimnasio." : item.Descripcion)
                    </p>

                    <!-- Caja de Precio Centrada -->
                    <div class="price-box w-100 py-3 px-2 rounded-4 mb-3" style="background-color: #F8FAFC; border: 1px solid rgba(0,0,0,0.04);">
                        <div class="d-flex align-items-baseline justify-content-center">
                            <span class="fs-6 fw-bold text-muted me-1">C$</span>
                            <span class="display-6 fw-bold text-dark">@item.Precio.ToString("N2")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(meta.periodicity))
                        {
                            <span class="text-muted fw-semibold small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                @meta.periodicity
                            </span>
                        }
                    </div>

                    <!-- Código identificador -->
                    <div class="small text-muted mb-3">
                        <code class="text-secondary bg-light px-2 py-1 rounded">@item.Clave</code>
                    </div>
                </div>

                <!-- Botón de Acción Centrado -->
                <div class="p-4 pt-0">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-brand rounded-pill w-100 py-2 fw-semibold shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-pencil-square"></i> Editar Tarifa
                    </a>
                </div>

            </div>
        </div>
    }
</div>

<style>
    .price-card {
        border-radius: 24px;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease;
    }
    .price-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.08) !important;
    }
    .shadow-xs {
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    }
</style>
