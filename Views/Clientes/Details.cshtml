@model FactorFitGym.Web.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="row g-4 justify-content-center mt-3">
    <!-- Perfil del Cliente -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body text-center p-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-factor-dark-opacity mx-auto mb-4 shadow overflow-hidden" style="width: 120px; height: 120px; padding: 12px;">
                    @if (string.Equals(Model.Genero?.Trim(), "Femenino", StringComparison.OrdinalIgnoreCase))
                    {
                        <img src="~/img/avatar-female.png" alt="Femenino" class="w-100 h-100" style="object-fit: contain;" asp-append-version="true" />
                    }
                    else
                    {
                        <img src="~/img/avatar-male.png" alt="Masculino" class="w-100 h-100" style="object-fit: contain;" asp-append-version="true" />
                    }
                </div>
                
                <h3 class="fw-bold mb-1 text-dark">@Model.Nombre @Model.Apellido</h3>
                <span class="badge @(Model.Genero == "Femenino" ? "bg-danger" : "bg-primary") rounded-pill px-3 mb-4">@Model.Genero</span>

                <ul class="list-unstyled text-start mt-2">
                    <li class="mb-3 border-bottom pb-2">
                        <i class="bi bi-telephone text-muted me-2"></i> 
                        <strong class="text-dark">Teléfono:</strong> <span class="text-secondary float-end">@(string.IsNullOrEmpty(Model.Telefono) ? "N/A" : Model.Telefono)</span>
                    </li>
                </ul>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning rounded-pill px-4 text-dark fw-bold shadow-sm w-100 mt-3"><i class="bi bi-pencil-fill me-2"></i>Editar Cliente</a>
            </div>
        </div>
    </div>

    <!-- Historial de Asistencias -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h4 class="fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Historial de Visitas</h4>
            </div>
            <div class="card-body p-4">
                @if (Model.Asistencias != null && Model.Asistencias.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-3">Fecha</th>
                                    <th class="py-3">Hora Entrada</th>
                                   
                                    <th class="py-3 text-center">Método</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asistencia in Model.Asistencias.OrderByDescending(a => a.FechaHoraEntrada).Take(10))
                                {
                                    <tr>
                                        <td><span class="fw-semibold text-dark">@asistencia.FechaHoraEntrada.ToString("dd MMM yyyy")</span></td>
                                        <td><span class="text-muted"><i class="bi bi-box-arrow-in-right me-1 text-success"></i> @asistencia.FechaHoraEntrada.ToString("hh:mm tt")</span></td>
                                       
                                        <td class="text-center">
                                            <span class="badge bg-light text-secondary border border-secondary rounded-pill">
                                                @(string.IsNullOrEmpty(asistencia.MetodoRegistro) ? "Manual" : asistencia.MetodoRegistro)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 opacity-50 d-block mb-3"></i>
                        <h5>Sin historial</h5>
                        <p>Este cliente no tiene registros de asistencia aún.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
