@using FactorFitGym.Web.Models
@inject FactorFitGym.Web.Models.ApplicationDbContext _db
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard Factor Fit</title>

    <link rel="icon" type="image/png" href="~/img/Logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper d-flex align-items-stretch">

        <nav id="sidebar" class="bg-factor-dark text-white shadow-lg d-flex flex-column justify-content-between">
            <div class="flex-grow-1">
            <div class="p-4 d-flex justify-content-center border-bottom border-factor-dark-lighter sidebar-logo-area">
                <a href="@Url.Action("Index", "Home")" class="d-inline-block logo-link" title="Volver al Inicio">
                    <img src="~/img/Logo.png" alt="Logo Factor Fit Gym" class="img-fluid logo-img" style="max-height: 140px;" asp-append-version="true">
                </a>
            </div>

            @{
                var ctrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                var act = ViewContext.RouteData.Values["Action"]?.ToString();
                bool isClientes = ctrl == "Clientes";
                bool isMemPagos = ctrl == "Membresias" || ctrl == "Pagos";
                bool isCaja = ctrl == "Ventas" || ctrl == "Productos" || ctrl == "Gastos";
                bool isEquipos = ctrl == "Equipos";
                bool isAsistencia = ctrl == "Asistencias";
                bool isPrecios = ctrl == "ConfiguracionPrecios";
                bool isUsuarios = ctrl == "Usuarios";
                bool isReportes = ctrl == "Reportes";
                bool isReservaciones = ctrl == "ReservacionesCanchas";

                int clientesSinMem = _db.Clientes
                    .Count(c => c.IsActivo && !c.Membresias.Any(m => m.Estado == "Activa"));
                var hoyLayout = DateTime.Today;
                var limiteAlertasLayout = hoyLayout.AddDays(7);
                int equiposAlertas = _db.Equipos
                    .Count(e => e.Estado != "Completado" && e.Estado != "De Baja" &&
                        (e.Estado == "Desgastado" || e.Estado == "Fuera de Servicio" || (e.ProximoMantenimiento.HasValue && e.ProximoMantenimiento.Value.Date <= limiteAlertasLayout)));
            }

            <ul class="list-unstyled components ps-3 py-3 pe-0 mt-3">

                <li class="mb-2">
                    <a href="#clientesSubmenu" data-bs-toggle="collapse" aria-expanded="@(isClientes ? "true" : "false")" class="text-decoration-none rounded menu-item @(isClientes ? "active" : "")">
                        <i class="bi bi-people-fill me-2 fs-4"></i> <span>Clientes</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isClientes ? "show" : "")" id="clientesSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Create", "Clientes")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isClientes && act == "Create" ? "active-sub" : "")"><i class="bi bi-person-plus-fill me-2"></i> Agregar Cliente</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Clientes")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isClientes && act == "Index" ? "active-sub" : "")"><i class="bi bi-card-list me-2"></i> Listado de Clientes</a>
                        </li>
                    </ul>
                </li>

                <li class="mb-2">
                    <a href="#membresiasSubmenu" data-bs-toggle="collapse" aria-expanded="@(isMemPagos ? "true" : "false")" class="text-decoration-none rounded menu-item @(isMemPagos ? "active" : "")">
                        <i class="bi bi-credit-card-fill me-2 fs-4"></i> <span>Membresías y Pagos</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isMemPagos ? "show" : "")" id="membresiasSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            @if(clientesSinMem > 0)
                            {
                                <a href="@Url.Action("Create", "Membresias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Membresias" && act == "Create" ? "active-sub" : "")"><i class="bi bi-pencil-square me-2"></i> Asignar Plan a Cliente</a>
                            }
                            else
                            {
                                <span class="d-block p-2 rounded text-start ps-5" style="color: rgba(255,255,255,0.3); cursor: not-allowed; font-size: 0.9rem;" title="Sin clientes disponibles para asignar">
                                    <i class="bi bi-pencil-square me-2"></i> Asignar Plan a Cliente
                                </span>
                            }
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Membresias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Membresias" && act == "Index" ? "active-sub" : "")"><i class="bi bi-calendar-check-fill me-2"></i> Directorio de Planes</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Pagos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Pagos" && act == "Index" ? "active-sub" : "")"><i class="bi bi-wallet2 me-2"></i> Historial de Recibos</a>
                        </li>
                    </ul>
                </li>

                <li class="mb-2"><a href="@Url.Action("Index", "ReservacionesCanchas")" class="text-decoration-none rounded menu-item @(isReservaciones ? "active" : "")"><i class="bi bi-calendar-event-fill me-2 fs-4"></i> <span>Reservaciones</span></a></li>
                
                <li class="mb-2">
                    <a href="#tiendaSubmenu" data-bs-toggle="collapse" aria-expanded="@(isCaja ? "true" : "false")" class="text-decoration-none rounded menu-item @(isCaja ? "active" : "")">
                        <i class="bi bi-shop-window me-2 fs-4"></i> <span>Caja y Tienda</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isCaja ? "show" : "")" id="tiendaSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Create", "Ventas")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Ventas" && act == "Create" ? "active-sub" : "")"><i class="bi bi-cart-plus-fill me-2"></i> Punto de Venta</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Productos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Productos" ? "active-sub" : "")"><i class="bi bi-box-seam-fill me-2"></i> Inventario</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Ventas")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Ventas" && act == "Index" ? "active-sub" : "")"><i class="bi bi-receipt me-2"></i> Tickets de Venta</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li>
                                <a href="@Url.Action("Index", "Gastos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(ctrl == "Gastos" ? "active-sub" : "")"><i class="bi bi-graph-down-arrow text-danger me-2"></i> Egresos / Gastos</a>
                            </li>
                        }
                    </ul>
                </li>

                <li class="mb-2">
                    <a href="#equiposSubmenu" data-bs-toggle="collapse" aria-expanded="@(isEquipos ? "true" : "false")" class="text-decoration-none rounded menu-item @(isEquipos ? "active" : "")">
                        <i class="bi bi-tools me-2 fs-4"></i> <span>Equipamiento</span>
                        @if (equiposAlertas > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-auto badge-alertas-parent" style="font-size: 0.7rem;">@equiposAlertas</span>
                        }
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isEquipos ? "show" : "")" id="equiposSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Create", "Equipos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isEquipos && act == "Create" ? "active-sub" : "")"><i class="bi bi-plus-circle me-2"></i> Nuevo Equipo</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Equipos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isEquipos && act == "Index" && string.IsNullOrEmpty(Context.Request.Query["filtro"]) ? "active-sub" : "")"><i class="bi bi-grid-fill me-2"></i> Inventario & Estado</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Equipos", new { filtro = "alertas" })" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 d-flex justify-content-between align-items-center pe-3 @(isEquipos && Context.Request.Query["filtro"] == "alertas" ? "active-sub" : "")">
                                <span><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Alertas Mant.</span>
                                @if (equiposAlertas > 0)
                                {
                                    <span class="badge rounded-pill bg-danger" style="font-size: 0.65rem;">@equiposAlertas</span>
                                }
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("HistorialGeneral", "Equipos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isEquipos && act == "HistorialGeneral" ? "active-sub" : "")"><i class="bi bi-clock-history me-2"></i> Bitácora de Servicios</a>
                        </li>
                    </ul>
                </li>
                <li class="mb-2">
                    <a href="#asistenciaSubmenu" data-bs-toggle="collapse" aria-expanded="@(isAsistencia ? "true" : "false")" class="text-decoration-none rounded menu-item @(isAsistencia ? "active" : "")">
                        <i class="bi bi-person-badge-fill me-2 fs-4"></i> <span>Asistencia</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isAsistencia ? "show" : "")" id="asistenciaSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Asistencias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isAsistencia && act == "Index" ? "active-sub" : "")"><i class="bi bi-fingerprint me-2"></i> Kiosco Check-In</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Historial", "Asistencias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5 @(isAsistencia && act == "Historial" ? "active-sub" : "")"><i class="bi bi-clock-history me-2"></i> Historial del Día</a>
                        </li>
                    </ul>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="mb-2"><a href="@Url.Action("Index", "ConfiguracionPrecios")" class="text-decoration-none rounded menu-item @(isPrecios ? "active" : "")"><i class="bi bi-tags-fill me-2 fs-4"></i> <span>Gestión de Precios</span></a></li>
                    <li class="mb-2"><a href="@Url.Action("Index", "Usuarios")" class="text-decoration-none rounded menu-item @(isUsuarios ? "active" : "")"><i class="bi bi-gear-fill me-2 fs-4"></i> <span>Adm. de Usuarios</span></a></li>
                    <li class="mb-2"><a href="@Url.Action("Index", "Reportes")" class="text-decoration-none rounded menu-item @(isReportes ? "active" : "")"><i class="bi bi-bar-chart-fill me-2 fs-4"></i> <span>Reportes</span></a></li>
                }
            </ul>
            </div>
            
        </nav>

        <div id="content" class="w-100 bg-light-blue position-relative">

            <nav class="navbar navbar-expand-lg top-header px-4 py-3 border-bottom-0" style="background-color: #F4F6F8 !important; border-bottom: 1px solid rgba(0,0,0,0.05) !important;">
                <div class="container-fluid">
                    <div class="d-none d-md-flex align-items-center">
                        @{
                            var horaActual = DateTime.Now.Hour;
                            string saludo = horaActual < 12 ? "Buenos días" : horaActual < 19 ? "Buenas tardes" : "Buenas noches";
                            string iconoSaludo = horaActual < 12 ? "bi-sunrise-fill text-warning" : horaActual < 19 ? "bi-brightness-high-fill text-warning" : "bi-moon-stars-fill text-primary";
                            string nombreUsuario = User.Identity.IsAuthenticated ? User.Identity.Name : "Usuario";
                        }
                        <div class="bg-white rounded-pill shadow-sm px-4 py-2 border border-secondary border-opacity-10 d-flex align-items-center">
                            <i class="bi @iconoSaludo fs-5 me-2"></i>
                            <span class="text-muted fw-medium mb-0" style="font-size: 0.95rem;">¡@saludo, <strong class="text-dark">@nombreUsuario</strong>!</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center ms-auto gap-4">
                        @{
                            var productosBajoStock = _db.Productos.Count(p => p.Stock <= p.StockMinimo);
                            var totalAlertasSistema = productosBajoStock + equiposAlertas;
                        }
                        <div class="dropdown">
                            <a href="#" class="notification-bell text-decoration-none border-0" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="outline: none;" title="Notificaciones">
                                <i class="bi bi-bell"></i>
                                @if (totalAlertasSistema > 0)
                                {
                                    <span class="position-absolute badge rounded-pill bg-danger shadow-sm border border-light" style="top: 0; right: 0; transform: translate(15%, -15%); font-size: 0.65rem; padding: 0.28em 0.48em;">
                                        @totalAlertasSistema
                                        <span class="visually-hidden">Alertas</span>
                                    </span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 p-2 bg-white notification-dropdown-card" aria-labelledby="notifDropdown" style="min-width: 300px;">
                                <li class="px-3 py-2 border-bottom d-flex align-items-center justify-content-between">
                                    <span class="fw-bold small text-dark">Centro de Notificaciones</span>
                                    @if (totalAlertasSistema > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger" style="font-size: 0.65rem;">@totalAlertasSistema pendientes</span>
                                    }
                                </li>
                                @if (productosBajoStock > 0)
                                {
                                    <li class="mt-1">
                                        <a class="dropdown-item py-2 px-3 rounded-3 d-flex align-items-center justify-content-between" href="@Url.Action("Index", "Productos", new { alertasStock = true })">
                                            <span><i class="bi bi-box-seam text-danger me-2"></i>Stock bajo en tienda</span>
                                            <span class="badge rounded-pill bg-danger">@productosBajoStock</span>
                                        </a>
                                    </li>
                                }
                                @if (equiposAlertas > 0)
                                {
                                    <li class="mt-1">
                                        <a class="dropdown-item py-2 px-3 rounded-3 d-flex align-items-center justify-content-between" href="@Url.Action("Index", "Equipos", new { filtro = "alertas" })">
                                            <span><i class="bi bi-tools text-warning me-2"></i>Equipos en alerta</span>
                                            <span class="badge rounded-pill bg-danger">@equiposAlertas</span>
                                        </a>
                                    </li>
                                }
                                @if (totalAlertasSistema == 0)
                                {
                                    <li class="px-3 py-3 text-center text-muted small">
                                        <i class="bi bi-check-circle-fill text-success fs-5 d-block mb-1"></i>
                                        Todo al día. No hay alertas pendientes.
                                    </li>
                                }
                            </ul>
                        </div>

                        <!-- Cápsula Ejecutiva: Círculo de usuario, rol y salir -->
                        <div class="user-capsule-pill bg-white shadow-sm border d-flex align-items-center">
                            <div class="user-capsule-avatar shadow-xs d-flex align-items-center justify-content-center">
                                <span>@(User.Identity.IsAuthenticated && !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")</span>
                            </div>
                            
                            <div class="d-flex flex-column text-start ps-2 pe-3 d-none d-sm-flex">
                                <span class="fw-bold text-dark lh-1" style="font-size: 0.85rem;">@(User.Identity.IsAuthenticated ? User.Identity.Name : "Usuario")</span>
                                <span class="text-muted lh-1 mt-1 fw-medium" style="font-size: 0.72rem;">@(User.IsInRole("Administrador") ? "Administrador" : "Empleado")</span>
                            </div>

                            <div class="vr my-1 opacity-25 me-1 d-none d-sm-block" style="height: 22px;"></div>

                            <form action="@Url.Action("Logout", "Account")" method="post" id="logoutForm" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-capsule-logout border-0" title="Cerrar Sesión">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="p-4 w-100 main-content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Operación Exitosa!',
                        text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'rounded-4 shadow-lg border-0'
                        }
                    });
                }
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Atención',
                        text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                        showConfirmButton: false,
                        timer: 2500,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'rounded-4 shadow-lg border-0'
                        }
                    });
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>