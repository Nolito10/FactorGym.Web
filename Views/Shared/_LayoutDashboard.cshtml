@using FactorFitGym.Web.Models
@inject FactorFitGym.Web.Models.ApplicationDbContext _db
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard Factor Fit</title>

    <link rel="icon" type="image/png" href="~/img/Logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper d-flex align-items-stretch">

        <nav id="sidebar" class="bg-factor-dark text-white shadow-lg d-flex flex-column justify-content-between">
            <div class="flex-grow-1">
            <div class="p-4 d-flex justify-content-center border-bottom border-factor-dark-lighter sidebar-logo-area">
                <a href="@Url.Action("Index", "Home")" class="d-inline-block logo-link" title="Volver al Inicio">
                    <img src="~/img/Logo.png" alt="Logo Factor Fit Gym" class="img-fluid logo-img" style="max-height: 140px;" asp-append-version="true">
                </a>
            </div>

            <ul class="list-unstyled components ps-3 py-3 pe-0 mt-3">

                <li class="mb-2">
                    <a href="#clientesSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="text-decoration-none rounded menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")">
                        <i class="bi bi-people-fill me-2 fs-4"></i> <span>Clientes</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2" id="clientesSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Create", "Clientes")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-center"><i class="bi bi-person-plus-fill me-2"></i> Agregar Cliente</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Clientes")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-center"><i class="bi bi-card-list me-2"></i> Listado de Clientes</a>
                        </li>
                    </ul>
                </li>

                @{
                    var ctrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                    bool isMemPagos = ctrl == "Membresias" || ctrl == "Pagos";
                    bool isCaja = ctrl == "Ventas" || ctrl == "Productos" || ctrl == "Gastos";
                    int clientesSinMem = _db.Clientes
                        .Count(c => c.IsActivo && !c.Membresias.Any(m => m.Estado == "Activa"));
                }
                <li class="mb-2">
                    <a href="#membresiasSubmenu" data-bs-toggle="collapse" aria-expanded="@(isMemPagos ? "true" : "false")" class="text-decoration-none rounded menu-item @(isMemPagos ? "active" : "")">
                        <i class="bi bi-credit-card-fill me-2 fs-4"></i> <span>Membresías y Pagos</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isMemPagos ? "show" : "")" id="membresiasSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            @if(clientesSinMem > 0)
                            {
                                <a href="@Url.Action("Create", "Membresias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-center"><i class="bi bi-pencil-square me-2"></i> Asignar Plan a Cliente</a>
                            }
                            else
                            {
                                <span class="d-block p-2 rounded text-center" style="color: rgba(255,255,255,0.3); cursor: not-allowed; font-size: 0.9rem;" title="Sin clientes disponibles para asignar">
                                    <i class="bi bi-pencil-square me-2"></i> Asignar Plan a Cliente
                                </span>
                            }
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Membresias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-center"><i class="bi bi-calendar-check-fill me-2"></i> Directorio de Planes</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Pagos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-center"><i class="bi bi-wallet2 me-2"></i> Historial de Recibos</a>
                        </li>
                    </ul>
                </li>

                <li class="mb-2"><a href="@Url.Action("Index", "ReservacionesCanchas")" class="text-decoration-none rounded menu-item @(ctrl == "ReservacionesCanchas" ? "active" : "")"><i class="bi bi-calendar-event-fill me-2 fs-4"></i> <span>Reservaciones</span></a></li>
                
                <li class="mb-2">
                    <a href="#tiendaSubmenu" data-bs-toggle="collapse" aria-expanded="@(isCaja ? "true" : "false")" class="text-decoration-none rounded menu-item @(isCaja ? "active" : "")">
                        <i class="bi bi-shop-window me-2 fs-4"></i> <span>Caja y Tienda</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(isCaja ? "show" : "")" id="tiendaSubmenu" data-bs-parent="#sidebar">
                        <li class="mb-1">
                            <a href="@Url.Action("Create", "Ventas")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-cart-plus-fill me-2"></i> Punto de Venta</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Productos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-box-seam-fill me-2"></i> Inventario</a>
                        </li>
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Ventas")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-receipt me-2"></i> Tickets de Venta</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li>
                                <a href="@Url.Action("Index", "Gastos")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-graph-down-arrow text-danger me-2"></i> Egresos / Gastos</a>
                            </li>
                        }
                    </ul>
                </li>
                <li class="mb-2">
                    <a href="#asistenciaSubmenu" data-bs-toggle="collapse" aria-expanded="@(ctrl == "Asistencias" ? "true" : "false")" class="text-decoration-none rounded menu-item @(ctrl == "Asistencias" ? "active" : "")">
                        <i class="bi bi-person-badge-fill me-2 fs-4"></i> <span>Asistencia</span>
                    </a>
                    <ul class="collapse list-unstyled mt-2 @(ctrl == "Asistencias" ? "show" : "")" id="asistenciaSubmenu">
                        <li class="mb-1">
                            <a href="@Url.Action("Index", "Asistencias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-fingerprint me-2"></i> Kiosco Check-In</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Historial", "Asistencias")" class="text-decoration-none d-block p-2 rounded sub-menu-item text-start ps-5"><i class="bi bi-clock-history me-2"></i> Historial del Día</a>
                        </li>
                    </ul>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="mb-2"><a href="@Url.Action("Index", "ConfiguracionPrecios")" class="text-decoration-none rounded menu-item @(ctrl == "ConfiguracionPrecios" ? "active" : "")"><i class="bi bi-tags-fill me-2 fs-4"></i> <span>Gestión de Precios</span></a></li>
                    <li class="mb-2"><a href="@Url.Action("Index", "Usuarios")" class="text-decoration-none rounded menu-item @(ctrl == "Usuarios" ? "active" : "")"><i class="bi bi-gear-fill me-2 fs-4"></i> <span>Adm. de Usuarios</span></a></li>
                    <li class="mb-2"><a href="@Url.Action("Index", "Reportes")" class="text-decoration-none rounded menu-item @(ctrl == "Reportes" ? "active" : "")"><i class="bi bi-bar-chart-fill me-2 fs-4"></i> <span>Reportes</span></a></li>
                }
            </ul>
            </div>
            
        </nav>

        <div id="content" class="w-100 bg-light-blue position-relative">

            <nav class="navbar navbar-expand-lg top-header px-4 py-3 border-bottom-0" style="background-color: #F4F6F8 !important; border-bottom: 1px solid rgba(0,0,0,0.05) !important;">
                <div class="container-fluid">
                    <div class="d-none d-md-flex align-items-center">
                        @{
                            var horaActual = DateTime.Now.Hour;
                            string saludo = horaActual < 12 ? "Buenos días" : horaActual < 19 ? "Buenas tardes" : "Buenas noches";
                            string iconoSaludo = horaActual < 12 ? "bi-sunrise-fill text-warning" : horaActual < 19 ? "bi-brightness-high-fill text-warning" : "bi-moon-stars-fill text-primary";
                            string nombreUsuario = User.Identity.IsAuthenticated ? User.Identity.Name : "Usuario";
                        }
                        <div class="bg-white rounded-pill shadow-sm px-4 py-2 border border-secondary border-opacity-10 d-flex align-items-center">
                            <i class="bi @iconoSaludo fs-5 me-2"></i>
                            <span class="text-muted fw-medium mb-0" style="font-size: 0.95rem;">¡@saludo, <strong class="text-dark">@nombreUsuario</strong>!</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center ms-auto gap-4">
                        @{
                            var productosBajoStock = _db.Productos.Count(p => p.Stock <= p.StockMinimo);
                        }
                        <a href="@Url.Action("Index", "Productos", new { alertasStock = true })" class="text-dark position-relative notification-bell">
                            <i class="bi bi-bell fs-5 text-muted"></i>
                            @if (productosBajoStock > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm border border-light" style="font-size: 0.65rem;">
                                    @productosBajoStock
                                    <span class="visually-hidden">Alertas</span>
                                </span>
                            }
                        </a>

                        <div class="dropdown">
                            <a class="text-decoration-none d-flex align-items-center dropdown-toggle user-menu-toggle" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-factor-dark user-avatar shadow-sm border border-secondary border-opacity-10" style="background-color: #E9ECEF;">
                                    <i class="bi bi-person-fill fs-5"></i>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3 rounded-3 bg-white" aria-labelledby="userDropdown">
                                <li>
                                    <div class="px-3 py-2">
                                        <p class="mb-0 fw-bold text-dark">@(User.Identity.IsAuthenticated ? User.Identity.Name : "Usuario")</p>
                                        <small class="text-muted">@(User.IsInRole("Administrador") ? "Administrador" : "Empleado")</small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="@Url.Action("Logout", "Account")" method="post" id="logoutForm">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2 border-0 bg-transparent w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i> Salir
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="p-4 w-100 main-content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>