@model FactorFitGym.Web.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3 px-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Editar Usuario</h2>
        <p class="text-muted mb-0">Modifica los datos del usuario @Model.Nombre @Model.Apellido.</p>
    </div>
</div>

<div class="d-flex justify-content-center px-2 mb-5">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex align-items-center justify-content-center flex-column">
                <div class="rounded-circle bg-dark d-flex align-items-center justify-content-center text-white mb-2 shadow-sm" style="width: 50px; height: 50px;">
                    <i class="bi bi-person-lines-fill fs-3"></i>
                </div>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" id="formEditUsuario">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="PasswordHash" /> <!-- Prevents validation fail on postback if empty -->

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold text-dark">Nombre de Usuario <span class="text-danger">*</span></label>
                            <div class="input-group drop-shadow-sm rounded-pill overflow-hidden bg-light border-0">
                                <span class="input-group-text bg-light border-0 ps-4 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="Username" class="form-control bg-light border-0 px-3 py-2" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small ms-3 mt-1 d-block"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="newPassword" class="form-label fw-semibold text-dark">Nueva Contraseña <span class="text-muted small fw-normal">(Opcional)</span></label>
                            <div class="input-group drop-shadow-sm rounded-pill overflow-hidden bg-light border-0">
                                <span class="input-group-text bg-light border-0 ps-4 text-muted"><i class="bi bi-key"></i></span>
                                <input type="password" id="newPassword" name="newPassword" class="form-control bg-light border-0 px-3 py-2" autocomplete="new-password" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label fw-semibold text-dark">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control rounded-pill bg-light border-0 px-4 py-2 drop-shadow-sm" />
                            <span asp-validation-for="Nombre" class="text-danger small ms-3 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label fw-semibold text-dark">Apellido <span class="text-danger">*</span></label>
                            <input asp-for="Apellido" class="form-control rounded-pill bg-light border-0 px-4 py-2 drop-shadow-sm" />
                            <span asp-validation-for="Apellido" class="text-danger small ms-3 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-dark">Email <span class="text-danger">*</span></label>
                            <div class="input-group drop-shadow-sm rounded-pill overflow-hidden bg-light border-0">
                                <span class="input-group-text bg-light border-0 ps-4 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control bg-light border-0 px-3 py-2" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small ms-3 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Rol" class="form-label fw-semibold text-dark">Rol del Usuario <span class="text-danger">*</span></label>
                            <select asp-for="Rol" class="form-select rounded-pill bg-light border-0 px-4 py-2 drop-shadow-sm fw-bold">
                                <option value="Administrador">Administrador (Acceso Total)</option>
                                <option value="Empleado">Empleado (Acceso Restringido)</option>
                                <option value="Cliente">Cliente (Solo Kiosco de Check-In)</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small ms-3 mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        <button type="submit" class="btn btn-dark rounded-pill px-5 py-2 fw-bold shadow-sm text-white fs-5">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .drop-shadow-sm { box-shadow: inset 0 1px 2px rgba(0,0,0,.03); }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('formEditUsuario').addEventListener('submit', function(e) {
            const form = this;
            if($(form).valid()) {
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Guardando...';
            }
        });
    </script>
}
