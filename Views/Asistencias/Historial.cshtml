@model IEnumerable<FactorFitGym.Web.Models.Asistencia>

@{
    ViewData["Title"] = "Historial de Asistencias";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-5 mt-3 px-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Historial de Asistencias</h2>
        <p class="text-muted mb-0">Registros de entrada del día de hoy.</p>
    </div>
    <div class="d-flex gap-3">
        <a href="@Url.Action("Index", "Asistencias")" class="btn btn-brand rounded-pill px-5 shadow-sm fw-bold">
            Abrir Kiosco
        </a>
    </div>
</div>

<div class="px-2" style="padding-bottom: 2rem;">
    <table class="table table-borderless align-middle w-100" style="border-collapse: separate; border-spacing: 0 15px;">
        <thead class="text-secondary small text-uppercase fw-bold">
            <tr>
                <th class="ps-4 pb-2">#</th>
                <th class="pb-2">Cliente</th>
                <th class="pb-2">Hora de Entrada</th>
                <th class="pb-2 text-center">Método</th>
            </tr>
        </thead>
        <tbody>
            @{ int idx = 1; }
            @foreach (var item in Model)
            {
                <tr class="bg-white shadow-sm" style="border-radius: 20px;">
                    <td class="ps-4 py-3 fw-bold text-muted" style="border-top-left-radius: 20px; border-bottom-left-radius: 20px;">@(idx++)</td>
                    <td class="py-3">
                        <h6 class="mb-0 fw-bold text-dark">@item.Cliente?.Nombre @item.Cliente?.Apellido</h6>
                    </td>
                    <td class="py-3 text-muted">
                        <i class="bi bi-clock me-1"></i> @item.FechaHoraEntrada.ToString("hh:mm tt")
                    </td>
                    <td class="py-3 text-center" style="border-top-right-radius: 20px; border-bottom-right-radius: 20px;">
                        <span class="badge bg-light text-secondary rounded-pill border px-3">@item.MetodoRegistro</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center py-5 mt-4 bg-white rounded-5 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-person-badge text-muted" style="font-size: 3rem;"></i>
            </div>
            <h5 class="text-dark fw-bold">Sin registros el día de hoy</h5>
            <p class="text-muted mb-0">Las asistencias registradas en el Kiosco aparecerán aquí automáticamente.</p>
        </div>
    }
</div>
