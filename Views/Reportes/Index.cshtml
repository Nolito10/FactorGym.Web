@{
    ViewData["Title"] = "Centro de Reportes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/flatpickr/themes/airbnb.css" asp-append-version="true" />

<style>
    .flatpickr-input[readonly] {
        background-color: #f8f9fa !important;
        cursor: pointer;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-5 mt-3 px-2">
    <div>
        <h2 class="fw-bold text-dark mb-0">Generador de Reportes Analíticos</h2>
    </div>
</div>

<div class="px-2 pb-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger text-danger border-0 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4">
        
        <!-- Panel 1: Finanzas -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100 p-4 border-top border-4 border-factor-dark" style="border-radius: 20px;">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-factor-dark-opacity d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-wallet2 text-factor-dark fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Flujo de Efectivo</h4>
                    <p class="text-muted small">Ingresos por membresías, ventas de tienda vs. Egresos y cálculo de utilidad neta.</p>
                </div>
                
                <form asp-action="ExportarFinanzasExcel" method="post" class="mt-auto">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Inicio</label>
                            <input type="text" name="fechaInicio" class="form-control rounded-pill bg-light border-0 fp-inicio text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Fin</label>
                            <input type="text" name="fechaFin" class="form-control rounded-pill bg-light border-0 fp-fin text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold" style="height: 45px;">
                        <i class="bi bi-file-earmark-excel-fill me-2"></i>Descargar Excel
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel 2: Afluencia -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100 p-4 border-top border-4 border-factor-slate" style="border-radius: 20px;">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-factor-slate-opacity d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-people-fill text-factor-slate fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Afluencia y Horarios</h4>
                    <p class="text-muted small">Reporte de check-ins en el kiosco para identificar horas pico y nivel de ocupación.</p>
                </div>
                
                <form asp-action="ExportarAfluenciaExcel" method="post" class="mt-auto">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Inicio</label>
                            <input type="text" name="fechaInicio" class="form-control rounded-pill bg-light border-0 fp-inicio text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Fin</label>
                            <input type="text" name="fechaFin" class="form-control rounded-pill bg-light border-0 fp-fin text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold" style="height: 45px;">
                        <i class="bi bi-file-earmark-excel-fill me-2"></i>Descargar Excel
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel 3: Rendimiento Tienda -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100 p-4 border-top border-4 border-factor-dark" style="border-radius: 20px;">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-factor-dark-opacity d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-shop text-factor-dark fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Rendimiento de Tienda</h4>
                    <p class="text-muted small">Análisis de los productos de mostrador para descubrir los más vendidos (Best Sellers).</p>
                </div>
                
                <form asp-action="ExportarTiendaExcel" method="post" class="mt-auto">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Inicio</label>
                            <input type="text" name="fechaInicio" class="form-control rounded-pill bg-light border-0 fp-inicio text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fecha Fin</label>
                            <input type="text" name="fechaFin" class="form-control rounded-pill bg-light border-0 fp-fin text-center fw-semibold text-dark shadow-none" placeholder="dd/mm/aaaa" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold" style="height: 45px;">
                        <i class="bi bi-file-earmark-excel-fill me-2"></i>Descargar Excel
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/flatpickr/l10n/es.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof flatpickr !== 'undefined') {
                flatpickr.localize(flatpickr.l10ns.es);

                const today = new Date();
                const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

                const fpConfig = {
                    locale: 'es',
                    altInput: true,
                    altFormat: 'd/m/Y',
                    dateFormat: 'Y-m-d',
                    altInputClass: 'form-control rounded-pill bg-light border-0 text-center fw-semibold text-dark shadow-none',
                    disableMobile: true
                };

                document.querySelectorAll('.fp-inicio').forEach(el => {
                    flatpickr(el, { ...fpConfig, defaultDate: firstDay });
                });

                document.querySelectorAll('.fp-fin').forEach(el => {
                    flatpickr(el, { ...fpConfig, defaultDate: today });
                });
            }
        });
    </script>
}
