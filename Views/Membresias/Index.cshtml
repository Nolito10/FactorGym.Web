@model IEnumerable<FactorFitGym.Web.Models.Membresia>

@{
    ViewData["Title"] = "Directorio de Membresías";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-5 mt-3 px-2">
    <div>
        <h2 class="fw-bold text-dark mb-1">Membresías y Suscripciones</h2>
        <p class="text-muted mb-0">Control general de planes activos e inactivos.</p>
    </div>
    <div class="d-flex gap-3 align-items-center">
        <!-- Barra de búsqueda -->
        <div class="input-group bg-white rounded-pill shadow-sm" style="width: 280px; overflow: hidden;">
            <span class="input-group-text bg-white border-0 pe-1"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="searchInput" class="form-control border-0 shadow-none ps-2" placeholder="Buscar por cliente...">
        </div>

        @if((int)(ViewBag.ClientesSinMembresia ?? 0) > 0)
        {
            <a href="@Url.Action("Create", "Membresias")" class="btn btn-brand rounded-pill px-5 shadow-sm fw-bold">Nueva Asignación</a>
        }
        else
        {
            <button type="button" class="btn btn-secondary rounded-pill px-5 shadow-sm fw-bold opacity-75" id="btnNuevaAsignacion">Nueva Asignación</button>
        }
    </div>
</div>

<div class="px-2" style="padding-bottom: 2rem; overflow-x: hidden;">
    <table class="table table-borderless align-middle w-100" id="membresiasTable" style="border-collapse: separate; border-spacing: 0 15px;">
        <thead class="text-secondary small text-uppercase fw-bold">
            <tr>
                <th class="ps-4 pb-2">Cliente</th>
                <th class="pb-2">Plan y Costo</th>
                <th class="pb-2 text-center">Fechas</th>
                <th class="pb-2 text-center">Estado</th>
                <th class="text-center pe-4 pb-2">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr class="membresia-row bg-white shadow-sm transition-all" style="border-radius: 20px;">
                    <td class="ps-4 py-3" style="border-top-left-radius: 20px; border-bottom-left-radius: 20px; width: 28%;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3 shadow-sm" style="width: 45px; height: 45px; background-color: var(--factor-dark-lighter);">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark cliente-filtro">@item.Cliente.Nombre @item.Cliente.Apellido</h6>
                                <small class="text-muted">Abonado</small>
                            </div>
                        </div>
                    </td>
                    <td class="py-3" style="width: 22%;">
                        <div class="d-flex flex-column text-muted">
                            <span class="text-dark fw-bold mb-1 plan-filtro">@item.Tipo (@item.TipoPlan)</span>
                            <span class="badge bg-light text-secondary border rounded-pill d-inline-block text-start w-auto px-3" style="font-size: 0.8rem;">
                                <i class="bi bi-cash me-1"></i> @item.Costo.ToString("C") / @item.Frecuencia
                            </span>
                        </div>
                    </td>
                    <td class="py-3 text-center" style="width: 20%;">
                        <div class="text-muted small">
                            <i class="bi bi-calendar-check text-success me-1"></i> @item.FechaInicio.ToString("dd MMM yyyy") <br/>
                            <i class="bi bi-calendar-x text-danger me-1 mt-1"></i> @item.FechaFin.ToString("dd MMM yyyy")
                        </div>
                    </td>
                    <td class="py-3 text-center" style="width: 15%;">
                        @if (item.Estado == "Activa") {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-4 py-2 fw-bold" style="font-size: 0.9rem;">
                                ACTIVA
                            </span>
                        } else if (item.Estado == "Vencida") {
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-4 py-2 fw-bold" style="font-size: 0.9rem;">
                                VENCIDA
                            </span>
                        } else {
                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-4 py-2 fw-bold" style="font-size: 0.9rem;">
                                @item.Estado.ToUpper()
                            </span>
                        }
                    </td>
                    <td class="text-center pe-4 py-3" style="border-top-right-radius: 20px; border-bottom-right-radius: 20px; width: 15%;">
                        <div class="d-flex justify-content-center gap-2">
                            
                            @if (item.Estado != "Vencida")
                            {
                                @if (item.Pagos != null && item.Pagos.Any())
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" 
                                         style="width: 38px; height: 38px; background-color: #d1fae5; border: 2px solid #22c55e;" 
                                         title="Membresía pagada">
                                        <i class="bi bi-check-lg" style="color: #16a34a; font-size: 1.2rem;"></i>
                                    </div>
                                }
                                else
                                {
                                    <a href="@Url.Action("Create", "Pagos", new { membresiaId = item.Id })" class="btn btn-sm btn-brand fw-bold px-3 rounded-pill d-flex align-items-center shadow-sm" title="Registrar Pago">
                                        Cobrar
                                    </a>
                                }
                            }
                            else
                            {
                                <a href="@Url.Action("Create", "Membresias", new { clienteId = item.ClienteId })" class="btn btn-sm btn-warning bg-opacity-75 border-0 text-dark fw-bold px-3 rounded-pill d-flex align-items-center shadow-sm" title="Renovar Plan">
                                    Renovar
                                </a>
                            }
                            <form action="@Url.Action("Delete", "Membresias", new { id = item.Id })" method="post" class="d-inline form-eliminar">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-light bg-opacity-50 border-0 text-danger fw-bold ms-1 rounded-pill d-flex align-items-center shadow-sm btn-delete-mem" title="Eliminar definitivamente">
                                    <i class="bi bi-trash fs-5"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5 mt-4 bg-white rounded-5 shadow-sm">
            <i class="bi bi-info-circle text-muted" style="font-size: 3rem;"></i>
            <h5 class="text-muted mt-3">Aún no hay membresías asignadas.</h5>
        </div>
    }

    @await Html.PartialAsync("_Pagination")
</div>

<style>
    .transition-all { transition: all 0.3s ease; }
    .membresia-row:hover { transform: translateY(-3px) scale(1.005); box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important; }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Check for TempData Success Message
            @if(TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                    confirmButtonText: 'Genial',
                    confirmButtonColor: '#28a745',
                    customClass: { popup: 'rounded-5 shadow-lg border-0', confirmButton: 'rounded-pill px-4' }
                });
                </text>
            }
            @if(TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: '¡Pago No Permitido!',
                    text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#dc3545',
                    customClass: { popup: 'rounded-5 shadow-lg border-0', confirmButton: 'rounded-pill px-4' }
                });
                </text>
            }

            // Btn Nueva Asignación deshabilitado
            const btnNuevaAsig = document.getElementById('btnNuevaAsignacion');
            if(btnNuevaAsig) {
                btnNuevaAsig.addEventListener('click', function() {
                    Swal.fire({
                        icon: 'info',
                        title: '¡Sin clientes disponibles!',
                        text: 'Todos los clientes activos ya tienen una membresía activa asignada. Para agregar una nueva, primero registra un nuevo cliente.',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#0A58CA',
                        customClass: { popup: 'rounded-5 shadow-lg border-0', confirmButton: 'rounded-pill px-4' }
                    });
                });
            }

            // Búsqueda en tiempo real
            const searchInput = document.getElementById('searchInput');
            if(searchInput) {
                searchInput.addEventListener('keyup', function() {
                    let value = this.value.toLowerCase();
                    const rows = document.querySelectorAll('#membresiasTable .membresia-row');
                    
                    rows.forEach(row => {
                        let text = row.querySelector('.cliente-filtro').textContent.toLowerCase();
                        let plan = row.querySelector('.plan-filtro').textContent.toLowerCase();
                        
                        if(text.includes(value) || plan.includes(value)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }

            // Confirmación Estética de Eliminación (SweetAlert2)
            const deleteButtons = document.querySelectorAll('.btn-delete-mem');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const form = this.closest('.form-eliminar');
                    Swal.fire({
                        title: '¿Eliminar Membresía?',
                        text: "Esta acción borrará el registro de la membresía permanentemente.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ff6b6b',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="bi bi-trash"></i> Sí, Eliminar',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        customClass: {
                            popup: 'rounded-5 shadow-lg border-0',
                            confirmButton: 'rounded-pill px-4 ms-2',
                            cancelButton: 'rounded-pill px-4'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}
