@model FactorFitGym.Web.Models.ReservacionCancha

@{
    ViewData["Title"] = "Reservaciones";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    decimal precioPorHora = ViewBag.PrecioCancha ?? 20.00m;
}

<link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/flatpickr/themes/airbnb.css" asp-append-version="true" />

<div class="d-flex align-items-center justify-content-center py-2" style="min-height: calc(100vh - 140px);">
    <div class="w-100" style="max-width: 950px;">
        
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <!-- Encabezado Centrado sin texto innecesario ni botón volver -->
                <div class="py-3 px-4 text-center border-bottom bg-white">
                    <h3 class="fw-bold text-dark mb-0">Reservaciones</h3>
                </div>

                <!-- Formulario -->
                <div class="card-body p-4 p-md-5">
                    <form id="formCreate" action="@Url.Action("Create", "ReservacionesCanchas")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MontoTotal" id="hiddenMontoTotal" value="@precioPorHora" />

                        <div class="row g-4">
                            <!-- Cliente / Responsable -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Cliente / Responsable</label>
                                <div class="input-group rounded-pill overflow-hidden border bg-light shadow-xs" style="height: 48px;">
                                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-primary">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <input asp-for="NombreCliente" type="text" class="form-control bg-transparent border-0 fw-semibold text-dark" placeholder="Nombre completo..." required>
                                </div>
                            </div>

                            <!-- Actividad / Deporte -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Actividad / Deporte</label>
                                <div class="input-group rounded-pill overflow-hidden border bg-light shadow-xs" style="height: 48px;">
                                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-primary">
                                        <i class="bi bi-activity"></i>
                                    </span>
                                    <select asp-for="TipoUso" id="TipoUso" class="form-select bg-transparent border-0 fw-semibold text-dark" required style="cursor: pointer;">
                                        <option value="Fútbol">Fútbol Sala</option>
                                        <option value="Básquetbol">Básquetbol</option>
                                        <option value="Voleibol">Voleibol</option>
                                        <option value="Evento">Evento / Exclusivo</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Fecha y Hora de Inicio (Flatpickr) -->
                            <div class="col-12 col-md-6">
                                <label id="labelFecha" class="form-label fw-bold text-secondary small text-uppercase mb-1">Fecha y Hora de Inicio</label>
                                <div class="input-group rounded-pill overflow-hidden border border-primary border-opacity-25 bg-white shadow-xs" style="height: 48px;">
                                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-primary">
                                        <i class="bi bi-calendar-event-fill"></i>
                                    </span>
                                    <input type="text" id="fechaInicioPicker" name="FechaHoraInicio" class="form-control bg-transparent border-0 fw-bold text-dark" placeholder="Selecciona fecha..." required>
                                </div>
                            </div>

                            <!-- Tiempo de Reserva -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Tiempo de Reserva</label>
                                
                                <!-- Opciones por hora para deportes -->
                                <div id="contenedorDuracionHoras" class="input-group rounded-pill overflow-hidden border border-primary border-opacity-25 bg-white shadow-xs" style="height: 48px;">
                                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-brand">
                                        <i class="bi bi-hourglass-split"></i>
                                    </span>
                                    <select id="duracionHoras" name="duracionHoras" class="form-select bg-transparent border-0 fw-bold text-dark" style="cursor: pointer;">
                                        <option value="1">1 Hora (60 min)</option>
                                        <option value="1.5">1 Hora y 30 min (90 min)</option>
                                        <option value="2">2 Horas (120 min)</option>
                                        <option value="2.5">2 Horas y 30 min (150 min)</option>
                                        <option value="3">3 Horas (180 min)</option>
                                        <option value="4">4 Horas (240 min)</option>
                                        <option value="5">5 Horas (300 min)</option>
                                    </select>
                                </div>

                                <!-- Día Completo para Evento Exclusivo -->
                                <div id="contenedorDuracionEvento" class="d-none">
                                    <div class="rounded-pill bg-light border px-3 d-flex align-items-center text-dark fw-bold" style="height: 48px;">
                                        <i class="bi bi-sun-fill text-warning me-2 fs-5"></i>
                                        <span>Día Completo (Evento Exclusivo)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Método de Cobro -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Método de Cobro</label>
                                <div class="input-group rounded-pill overflow-hidden border bg-light shadow-xs" style="height: 48px;">
                                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-primary">
                                        <i class="bi bi-credit-card-2-front-fill"></i>
                                    </span>
                                    <select asp-for="MetodoPago" id="MetodoPago" class="form-select bg-transparent border-0 fw-semibold text-dark" required style="cursor: pointer;">
                                        <option value="Efectivo" selected>Efectivo</option>
                                        <option value="Transferencia">Transferencia Bancaria</option>
                                        <option value="Tarjeta">Tarjeta Débito / Crédito</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Monto Total a Cobrar -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-1">Monto Total a Cobrar (C$)</label>
                                
                                <!-- Tarifa Calculada para Deportes (Cancha por hora) -->
                                <div id="contenedorCobroAuto">
                                    <div class="px-3 rounded-pill d-flex align-items-center justify-content-between border border-success border-opacity-50" style="background-color: #F0FDF4; height: 48px;">
                                        <div class="d-flex align-items-center text-success">
                                            <i class="bi bi-cash-stack fs-5 me-2"></i>
                                            <small class="fw-semibold text-muted" id="formulaLabel">1 hr × C$@precioPorHora.ToString("N2")</small>
                                        </div>
                                        <div>
                                            <span class="fs-5 fw-bold text-success" id="displayMontoTotal">C$ @precioPorHora.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Precio Acordado para Evento Exclusivo -->
                                <div id="contenedorCobroEvento" class="d-none">
                                    <div class="input-group rounded-pill overflow-hidden border border-success bg-white shadow-xs" style="height: 48px;">
                                        <span class="input-group-text bg-success bg-opacity-10 border-0 ps-3 pe-2 text-success fw-bold">
                                            C$
                                        </span>
                                        <input type="number" step="0.01" min="1" id="inputMontoEvento" class="form-control bg-transparent border-0 fw-bold text-dark" placeholder="Precio acordado (C$)...">
                                    </div>
                                    <small class="text-muted d-block ps-2 mt-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-info-circle me-1"></i> Precio acordado cliente - propietario.
                                    </small>
                                </div>
                            </div>

                            <!-- Botón de Envío: Más pequeño y conciso -->
                            <div class="col-12 text-center mt-3 pt-2">
                                <button type="submit" id="btnSubmit" class="btn btn-brand rounded-pill px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center justify-content-center">
                                    <i class="bi bi-check2 me-1"></i> Confirmar
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

<style>
    .shadow-xs { box-shadow: 0 2px 6px rgba(0,0,0,0.04); }
</style>

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/flatpickr/l10n/es.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            @if(TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#dc3545',
                    customClass: { popup: 'rounded-4 shadow-lg border-0', confirmButton: 'rounded-pill px-4' }
                });
                </text>
            }

            const tarifaBase = parseFloat("@precioPorHora.ToString(System.Globalization.CultureInfo.InvariantCulture)");
            const tipoUsoSelect = document.getElementById('TipoUso');
            const labelFecha = document.getElementById('labelFecha');
            const duracionSelect = document.getElementById('duracionHoras');
            const contenedorDuracionHoras = document.getElementById('contenedorDuracionHoras');
            const contenedorDuracionEvento = document.getElementById('contenedorDuracionEvento');
            const contenedorCobroAuto = document.getElementById('contenedorCobroAuto');
            const contenedorCobroEvento = document.getElementById('contenedorCobroEvento');
            const formulaLabel = document.getElementById('formulaLabel');
            const displayMontoTotal = document.getElementById('displayMontoTotal');
            const inputMontoEvento = document.getElementById('inputMontoEvento');
            const hiddenMontoTotal = document.getElementById('hiddenMontoTotal');

            // Flatpickr handler
            let fp = null;
            function initPicker(isEvento) {
                if (fp) {
                    fp.destroy();
                }

                const defaultDate = new Date();
                if (!isEvento) {
                    defaultDate.setMinutes(0, 0, 0);
                    defaultDate.setHours(defaultDate.getHours() + 1);
                }

                fp = flatpickr("#fechaInicioPicker", {
                    enableTime: !isEvento,
                    dateFormat: isEvento ? "Y-m-d 06:00" : "Y-m-d H:i",
                    altInput: true,
                    altFormat: isEvento ? "d/m/Y" : "d/m/Y h:i K",
                    minDate: "today",
                    defaultDate: defaultDate,
                    time_24hr: false,
                    minuteIncrement: 15,
                    locale: "es"
                });
            }

            // Actualizar total para deportes
            function actualizarTotalDeporte() {
                const horas = parseFloat(duracionSelect.value) || 1;
                const total = horas * tarifaBase;
                formulaLabel.textContent = `${horas} hr${horas > 1 ? 's' : ''} × C$${tarifaBase.toFixed(2)}`;
                displayMontoTotal.textContent = `C$ ${total.toFixed(2)}`;
                hiddenMontoTotal.value = total.toFixed(2);
            }

            // Cambiar vista según Tipo de Actividad
            function toggleTipoUso() {
                const isEvento = tipoUsoSelect.value === 'Evento';

                if (isEvento) {
                    labelFecha.textContent = 'Fecha del Evento';
                    contenedorDuracionHoras.classList.add('d-none');
                    duracionSelect.disabled = true;
                    contenedorDuracionEvento.classList.remove('d-none');
                    contenedorCobroAuto.classList.add('d-none');
                    contenedorCobroEvento.classList.remove('d-none');
                    inputMontoEvento.required = true;
                    hiddenMontoTotal.value = inputMontoEvento.value || '';
                    initPicker(true);
                } else {
                    labelFecha.textContent = 'Fecha y Hora de Inicio';
                    contenedorDuracionHoras.classList.remove('d-none');
                    duracionSelect.disabled = false;
                    contenedorDuracionEvento.classList.add('d-none');
                    contenedorCobroAuto.classList.remove('d-none');
                    contenedorCobroEvento.classList.add('d-none');
                    inputMontoEvento.required = false;
                    actualizarTotalDeporte();
                    initPicker(false);
                }
            }

            duracionSelect.addEventListener('change', actualizarTotalDeporte);
            tipoUsoSelect.addEventListener('change', toggleTipoUso);

            inputMontoEvento.addEventListener('input', function () {
                hiddenMontoTotal.value = this.value;
            });

            // Inicialización inicial
            toggleTipoUso();

            // Submit del formulario
            const formCreate = document.getElementById('formCreate');
            formCreate.addEventListener('submit', function (e) {
                if (tipoUsoSelect.value === 'Evento') {
                    const rawVal = (inputMontoEvento.value || '').trim().replace(',', '.');
                    const monto = parseFloat(rawVal);
                    if (isNaN(monto) || monto <= 0) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Precio Acordado Requerido',
                            text: 'Por favor, digite el precio total acordado con el cliente para el evento exclusivo.',
                            confirmButtonColor: '#0d6efd',
                            confirmButtonText: 'OK',
                            customClass: { popup: 'rounded-4 shadow-lg border-0', confirmButton: 'rounded-pill px-4' }
                        });
                        inputMontoEvento.focus();
                        return false;
                    }
                    hiddenMontoTotal.value = monto.toString();
                } else {
                    const horas = parseFloat(duracionSelect.value) || 1;
                    hiddenMontoTotal.value = (horas * tarifaBase).toFixed(2);
                }

                const btnSubmit = document.getElementById('btnSubmit');
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Guardando...';
            });
        });
    </script>
}
