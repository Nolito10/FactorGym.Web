@model IEnumerable<FactorFitGym.Web.Models.Equipo>

@{
    ViewData["Title"] = "Equipamiento";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var categoriaActiva = ViewBag.CategoriaSeleccionada as string ?? "Todas";
    var filtroActivo = ViewBag.FiltroActivo as string;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<style>
    .kpi-card {
        border-radius: 18px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
    }
    .equipment-card {
        border-radius: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .equipment-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.07) !important;
    }
    .filter-pill {
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .filter-pill.active {
        background-color: var(--brand-blue) !important;
        color: #ffffff !important;
    }
</style>

<!-- Cabecera Limpia -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-4 mt-2 px-2">
    <div>
        <h3 class="fw-bold text-dark mb-0">
            <i class="bi bi-tools text-brand me-2"></i>Equipos & Mantenimiento
        </h3>
    </div>
    <div class="d-flex justify-content-center gap-2">
        <a href="@Url.Action("HistorialGeneral", "Equipos")" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-clock-history me-1"></i>Bitácora
        </a>
        <a href="@Url.Action("Create", "Equipos")" class="btn btn-brand rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Nuevo Equipo
        </a>
    </div>
</div>

<!-- KPIs Compactos -->
<div class="row g-3 mb-4 px-2">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 kpi-card bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Total Equipos</span>
            <h3 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalEquipos</h3>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 kpi-card bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Operativos</span>
            <h3 class="fw-bold text-success mb-0 mt-1">@ViewBag.TotalOperativos</h3>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 kpi-card bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Con Desgaste</span>
            <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.TotalDesgastados</h3>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <a href="@Url.Action("Index", "Equipos", new { filtro = "alertas" })" class="text-decoration-none">
            <div class="card border-0 shadow-sm p-3 kpi-card bg-white text-center border border-danger border-opacity-25">
                <span class="text-danger small fw-bold text-uppercase">Alertas Activas</span>
                <h3 class="fw-bold text-danger mb-0 mt-1">@ViewBag.TotalMantenimientosAlertas</h3>
            </div>
        </a>
    </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 mx-2 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        
        <!-- Filtros Categoría / Estado en Pills -->
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="@Url.Action("Index", "Equipos")" 
               class="badge filter-pill text-decoration-none rounded-pill px-3 py-2 bg-light text-dark @(categoriaActiva == "Todas" && string.IsNullOrEmpty(filtroActivo) ? "active" : "")">
                Todos
            </a>
            <a href="@Url.Action("Index", "Equipos", new { categoria = "Peso Libre" })" 
               class="badge filter-pill text-decoration-none rounded-pill px-3 py-2 bg-light text-dark @(categoriaActiva == "Peso Libre" ? "active" : "")">
                Mancuernas / Discos
            </a>
            <a href="@Url.Action("Index", "Equipos", new { categoria = "Fuerza y Máquinas" })" 
               class="badge filter-pill text-decoration-none rounded-pill px-3 py-2 bg-light text-dark @(categoriaActiva == "Fuerza y Máquinas" ? "active" : "")">
                Máquinas
            </a>
            <a href="@Url.Action("Index", "Equipos", new { categoria = "Cardio" })" 
               class="badge filter-pill text-decoration-none rounded-pill px-3 py-2 bg-light text-dark @(categoriaActiva == "Cardio" ? "active" : "")">
                Cardio
            </a>
            <a href="@Url.Action("Index", "Equipos", new { filtro = "alertas" })" 
               class="badge filter-pill text-decoration-none rounded-pill px-3 py-2 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 @(filtroActivo == "alertas" ? "active text-white" : "")">
                <i class="bi bi-bell-fill me-1"></i>Alertas (@ViewBag.TotalMantenimientosAlertas)
            </a>
        </div>

        <!-- Buscador -->
        <div class="input-group bg-light rounded-pill px-3 py-1" style="max-width: 260px;">
            <span class="input-group-text bg-transparent border-0 pe-2 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="liveSearchInput" class="form-control bg-transparent border-0 shadow-none ps-0" placeholder="Buscar equipo..." value="@searchTerm">
        </div>
    </div>
</div>

<!-- Grid de Tarjetas Limpias -->
<div class="px-2 pb-5">
    <div class="row g-3" id="equiposGrid">
        @foreach (var item in Model)
        {
            bool tieneAlerta = item.RequiereAtencion;
            string borderCard = tieneAlerta ? "border border-danger border-opacity-50" : "border-0";

            string badgeEstado = item.Estado switch
            {
                "Operativo" => "bg-success text-white",
                "Desgastado" => "bg-warning text-dark",
                "En Mantenimiento" => "bg-info text-dark",
                "Fuera de Servicio" => "bg-danger text-white",
                _ => "bg-secondary text-white"
            };

            <div class="col-12 col-md-6 col-lg-4 col-xl-3 equipo-card-wrapper" 
                 data-nombre="@item.Nombre.ToLower()" 
                 data-codigo="@(item.Codigo?.ToLower() ?? "")"
                 data-ubicacion="@(item.Ubicacion?.ToLower() ?? "")">
                
                <div class="card shadow-sm h-100 equipment-card bg-white p-3 d-flex flex-column justify-content-between @borderCard">
                    <div>
                        <!-- Encabezado Tarjeta -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                                @item.Categoria
                            </span>
                            <span class="badge rounded-pill px-2 py-1 @badgeEstado">
                                @item.Estado
                            </span>
                        </div>

                        <!-- Nombre y Código -->
                        <h6 class="fw-bold text-dark mb-1">@item.Nombre</h6>
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span>@(item.Codigo ?? "S/C")</span>
                            <span>@(item.Ubicacion ?? "Piso Principal")</span>
                        </div>

                        <!-- Estado / Desgaste / Mantenimiento Compacto -->
                        <div class="bg-light rounded-3 p-2 my-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Desgaste:</span>
                                <strong class="@(item.NivelDesgaste == "Crítico" ? "text-danger" : item.NivelDesgaste == "Moderado" ? "text-warning" : "text-dark")">
                                    @(item.NivelDesgaste ?? "Ninguno")
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Próx. Servicio:</span>
                                @if (item.MantenimientoVencido)
                                {
                                    <strong class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vencido</strong>
                                }
                                else if (item.MantenimientoProximo)
                                {
                                    <strong class="text-warning"><i class="bi bi-clock-fill me-1"></i>En @item.DiasParaProximoMantenimiento d</strong>
                                }
                                else if (item.ProximoMantenimiento.HasValue)
                                {
                                    <span class="text-dark">@item.ProximoMantenimiento.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                        {
                            <p class="text-muted small mb-1 text-truncate" title="@item.Observaciones" style="font-size: 0.8rem;">
                                <i class="bi bi-chat-text me-1"></i>@item.Observaciones
                            </p>
                        }
                    </div>

                    <!-- Botones Centrados -->
                    <div class="pt-3 border-top d-flex justify-content-center align-items-center gap-2 flex-wrap">
                        <a href="@Url.Action("Details", "Equipos", new { id = item.Id })" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold">
                            Detalles
                        </a>
                        @if (item.RequiereAtencion)
                        {
                            <form asp-action="CompletarAlerta" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold shadow-sm" title="Marcar alerta como completada y resuelta">
                                    <i class="bi bi-check2-circle me-1"></i>Completar
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold"
                                    onclick="abrirModalDesgaste(@item.Id, '@item.Nombre.Replace("'", "\\'")', '@item.Estado', '@item.NivelDesgaste', '@(item.Observaciones?.Replace("'", "\\'") ?? "")')">
                                Reportar
                            </button>
                        }
                        <a href="@Url.Action("Edit", "Equipos", new { id = item.Id })" class="btn btn-sm btn-light border rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Editar">
                            <i class="bi bi-pencil-fill text-muted" style="font-size: 0.8rem;"></i>
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-5 shadow-sm mt-3">
            <i class="bi bi-tools text-muted fs-1 mb-2 d-block"></i>
            <h6 class="fw-bold text-dark">Sin equipos encontrados</h6>
            <div class="mt-3 text-center">
                <a href="@Url.Action("Create", "Equipos")" class="btn btn-brand rounded-pill px-4 fw-bold">Registrar Equipo</a>
            </div>
        </div>
    }
</div>

<!-- Modal Centrado: Reportar Desgaste -->
<div class="modal fade" id="modalReportarDesgaste" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-5 overflow-hidden">
            <div class="modal-header border-0 pt-4 px-4 pb-0 text-center d-block">
                <h5 class="modal-title fw-bold text-dark" id="modalEquipoNombre">Reportar Estado</h5>
            </div>

            <form asp-action="ReportarDesgasteRapido" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="equipoId" id="modalEquipoId" value="" />
                
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Desgaste</label>
                        <select name="nivelDesgaste" id="modalNivelDesgaste" class="form-select rounded-pill border-0 px-3 py-2 bg-light">
                            <option value="Leve">🟡 Leve</option>
                            <option value="Moderado" selected>🟠 Moderado</option>
                            <option value="Crítico">🔴 Crítico</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Estado</label>
                        <select name="estado" id="modalEstado" class="form-select rounded-pill border-0 px-3 py-2 bg-light">
                            <option value="Desgastado" selected>Desgastado</option>
                            <option value="En Mantenimiento">En Mantenimiento</option>
                            <option value="Fuera de Servicio">Fuera de Servicio</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">Observación</label>
                        <textarea name="observacion" id="modalObservacion" rows="2" class="form-control rounded-4 border-0 p-3 bg-light" placeholder="Detalle rápido..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer border-0 px-4 pb-4 pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold shadow-sm">Guardar Reporte</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('liveSearchInput')?.addEventListener('keyup', function () {
            let filter = this.value.toLowerCase().trim();
            document.querySelectorAll('.equipo-card-wrapper').forEach(card => {
                let text = (card.getAttribute('data-nombre') || '') + ' ' + (card.getAttribute('data-codigo') || '') + ' ' + (card.getAttribute('data-ubicacion') || '');
                card.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        function abrirModalDesgaste(id, nombre, estado, nivelDesgaste, obs) {
            document.getElementById('modalEquipoId').value = id;
            document.getElementById('modalEquipoNombre').innerText = nombre;
            if (nivelDesgaste && nivelDesgaste !== 'Ninguno') {
                document.getElementById('modalNivelDesgaste').value = nivelDesgaste;
            }
            if (estado && estado !== 'Operativo') {
                document.getElementById('modalEstado').value = estado;
            }
            document.getElementById('modalObservacion').value = obs || '';
            new bootstrap.Modal(document.getElementById('modalReportarDesgaste')).show();
        }
    </script>
}
